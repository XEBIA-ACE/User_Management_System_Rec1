# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=userdb
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=user.exchange
RABBITMQ_QUEUE_USER_REGISTERED=user.registered
RABBITMQ_QUEUE_USER_DELETED=user.deleted
RABBITMQ_ROUTING_KEY_USER_REGISTERED=user.registered
RABBITMQ_ROUTING_KEY_USER_DELETED=user.deleted

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=3600000
