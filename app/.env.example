# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/user_management
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE_NOTIFICATIONS=notifications.exchange
RABBITMQ_QUEUE_OTP=otp.queue
RABBITMQ_ROUTING_KEY_OTP=otp.send

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars
JWT_EXPIRATION_MS=3600000
